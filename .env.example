# Backend al que apunta el proxy de Vite en desarrollo:
#   native -> /api/usuarios=8001, /api/lecciones=8002, /api/progreso=8003 (servicios con uvicorn)
#   docker -> /api -> http://localhost:8080 (nginx de consultaya-deploy)
VITE_BACKEND=native

# true = el navegador usa mocks de MSW en lugar del backend (solo en `npm run dev`)
VITE_API_MOCKS=false
